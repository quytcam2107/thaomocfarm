APP_NAME="Thảo Mộc Farm"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://thaomocfarm.local
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thaomocfarm
DB_USERNAME=thaomocfarm
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=thaomocfarm_

MEMCACHED_HOST=127.0.0.1

# === THAO MOC FARM CUSTOM ===
# Nhóm cache version: mỗi nhóm có 1 key version, bump khi admin cập nhật
# Ví dụ: THAOMOC_CACHE_VERSIONS[home]=v3
# Helper remember_group() tự kết hợp version vào cache key
THAOMOC_CACHE_DEFAULT_TTL=600

# Rate limit
THAOMOC_RATE_LIMIT_LOGIN=5
THAOMOC_RATE_LIMIT_CHECKOUT=10
THAOMOC_RATE_LIMIT_COUPON=20

# Order prefix
THAOMOC_ORDER_PREFIX=TMX

# Upload
THAOMOC_MAX_UPLOAD_MB=8
THAOMOC_ALLOWED_MIMES=image/jpeg,image/png,image/webp

# Mail (smtp local)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@thaomocfarm.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (KHÔNG dùng - giữ để Laravel không lỗi validate)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"